# Duit web image. Build from the repo root:  docker build -f Dockerfile.web -t duit-web .
# Multi-stage: Node builds the static export in "builder"; "runtime" is nginx serving files only,
# so no Node.js, npm or node_modules ever reaches the cluster.

FROM node:26.13.1-alpine3.24 AS builder
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /web
# Dependencies first: this layer is cached until package-lock.json changes.
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build && node scripts/csp.mjs out > security-headers.conf

FROM nginxinc/nginx-unprivileged:1.30.6-alpine3.24 AS runtime
USER root
# Alpine security fixes published since the base image was built.
RUN apk upgrade --no-cache
USER 101
COPY web/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /web/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /web/out /usr/share/nginx/html
EXPOSE 8080
